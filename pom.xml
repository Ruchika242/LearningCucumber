<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>LearningCucumber</artifactId>
    <version>1.0-SNAPSHOT</version>


    <!-- ========================================================= -->
    <!-- PROPERTIES                                                -->
    <!-- ========================================================= -->

    <properties>

        <!-- Java -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Selenium -->
        <selenium.version>4.34.0</selenium.version>

        <!-- Cucumber -->
        <cucumber.version>7.23.0</cucumber.version>

        <!-- JUnit -->
        <junit.version>5.11.4</junit.version>
        <junit.platform.version>1.11.4</junit.platform.version>

        <!-- TestNG -->
        <testng.version>7.11.0</testng.version>

        <!-- Surefire -->
        <surefire.version>3.5.3</surefire.version>

        <!-- WebDriverManager -->
        <webdrivermanager.version>6.1.0</webdrivermanager.version>

        <!-- Apache POI -->
        <poi.version>5.2.5</poi.version>

        <!-- Log4j -->
        <log4j.version>2.23.1</log4j.version>


        <!-- ===================================================== -->
        <!-- DEFAULT TEST EXECUTION SETTINGS                       -->
        <!-- ===================================================== -->


        <headless>false</headless>

        <env>qa</env>

        <grid.enabled>false</grid.enabled>

        <grid.url>http://10.0.0.153:4444</grid.url>

        <cucumber.filter.tags></cucumber.filter.tags>

        <!-- TestNG handles parallel execution -->
        <cucumber.execution.parallel.enabled>false</cucumber.execution.parallel.enabled>

    </properties>


    <!-- ========================================================= -->
    <!-- DEPENDENCIES                                              -->
    <!-- ========================================================= -->

    <dependencies>


        <!-- ===================================================== -->
        <!-- SELENIUM                                               -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- CUCUMBER                                               -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- TESTNG                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- WEBDRIVER MANAGER                                      -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- APACHE POI                                             -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- LOG4J2                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- BUILD                                                     -->
    <!-- ========================================================= -->

    <build>

        <plugins>


            <!-- ================================================= -->
            <!-- MAVEN SUREFIRE                                    -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>

                <configuration>

                    <!-- Required for Java 21 -->
                    <useModulePath>false</useModulePath>


                    <!-- ========================================= -->
                    <!-- IMPORTANT: USE TESTNG XML SUITE           -->
                    <!-- ========================================= -->

                    <suiteXmlFiles>

                        <suiteXmlFile>
                            src/test/resources/testNG.xml
                        </suiteXmlFile>

                    </suiteXmlFiles>

                    <!-- Keep execution in one JVM so the custom plugin can aggregate all browser runs. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>


                    <!-- ========================================= -->
                    <!-- PASS MAVEN PROPERTIES TO JAVA             -->
                    <!-- ========================================= -->

                    <systemPropertyVariables>

                        <browser>
                            ${browser}
                        </browser>

                        <headless>
                            ${headless}
                        </headless>

                        <env>
                            ${env}
                        </env>

                        <grid.enabled>
                            ${grid.enabled}
                        </grid.enabled>

                        <grid.url>
                            ${grid.url}
                        </grid.url>

                        <cucumber.filter.tags>
                            ${cucumber.filter.tags}
                        </cucumber.filter.tags>

                        <cucumber.execution.parallel.enabled>
                            ${cucumber.execution.parallel.enabled}
                        </cucumber.execution.parallel.enabled>

                    </systemPropertyVariables>

                </configuration>

            </plugin>



        </plugins>

    </build>


    <!-- ========================================================= -->
    <!-- PROFILES                                                  -->
    <!-- ========================================================= -->

    <profiles>


        <!-- ===================================================== -->
        <!-- LOCAL PROFILE                                         -->
        <!-- ===================================================== -->

        <profile>

            <id>local</id>

            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <properties>

                <headless>false</headless>

                <env>qa</env>

                <grid.enabled>false</grid.enabled>

                <cucumber.execution.parallel.enabled>
                    false
                </cucumber.execution.parallel.enabled>

            </properties>

        </profile>


        <!-- ===================================================== -->
        <!-- GRID / CI PROFILE                                     -->
        <!-- ===================================================== -->

        <profile>

            <id>ci</id>

            <properties>

                <headless>true</headless>

                <env>ci</env>

                <grid.enabled>true</grid.enabled>

                <grid.url>
                    http://10.0.0.153:4444
                </grid.url>

                <!-- TestNG controls parallel execution -->
                <cucumber.execution.parallel.enabled>
                    true
                </cucumber.execution.parallel.enabled>

            </properties>

        </profile>

    </profiles>

</project>